;==============================================================
; chatgpt001_XAUUSD_400USD_ranges.set
; 场景：Exness XAUUSD，初始资金约400 USD
; 默认：固定0.01手，便于观察真实盈亏结构；利滚利功能保留但默认关闭
; 格式：参数=默认值||起点||步长||终点||是否优化(Y/N)
; 建议：不要一次优化所有 Y，按 README 的阶段分组优化。
;==============================================================

; ---------------- 基础 / 固定手数 / 利滚利 ----------------
InpMagicNum=310001
InpTrendMagicNum=310002
InpLotSize=0.01||0.01||0.01||0.03||N
InpUseDynamicLot=false||false||1||true||N
InpLotByEquity=false||false||1||true||N
